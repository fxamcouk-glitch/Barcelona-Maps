rules_version = '2';
// Anyone with the link can read and change the trip's places, but only
// in the "places" collection and only with sensible, size-limited fields.
service cloud.firestore {
  match /databases/{database}/documents {
    match /places/{placeId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if isPlace(request.resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
  function isPlace(d) {
    return d.keys().hasOnly(['name','type','area','order','note','from','hours','walk','lat','lng','pid','address','link','bookUrl','book','addedBy','createdAt','editedAt','editedBy'])
      && d.name is string && d.name.size() > 0 && d.name.size() <= 100
      && d.type in ['see','eat']
      && d.lat is number && d.lng is number
      && d.lat > 41.0 && d.lat < 41.8 && d.lng > 1.7 && d.lng < 2.6
      && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
      && (!('from' in d) || (d.from is string && d.from.size() <= 200))
      && (!('address' in d) || (d.address is string && d.address.size() <= 300))
      && (!('link' in d) || (d.link is string && d.link.size() <= 600))
      && (!('addedBy' in d) || (d.addedBy is string && d.addedBy.size() <= 60))
      && (!('editedBy' in d) || (d.editedBy is string && d.editedBy.size() <= 60));
  }
}
